# OpenAI (ChatGPT) API（必須）
OPENAI_API_KEY=your_api_key_here
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-2
KOKOROE_REVIEW_IMAGE_SIZE=1536x2304
KOKOROE_REVIEW_IMAGE_QUALITY=high
KOKOROE_PRINT_IMAGE_SIZE=2304x3456
KOKOROE_PRINT_IMAGE_QUALITY=high

# レビュー・修正・作品生成ワークフロー
# 両方を設定すると自動的に有効化。service role key はブラウザへ公開しないこと。
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
KOKOROE_STORAGE_BUCKET=makaren-deliverables
PUBLIC_BASE_URL=https://your-kokoroe-app.example.com

# オプション: サーバー設定
FLASK_ENV=development
FLASK_PORT=5001

# SMTP（メール送信に必須）
# 最低限: SMTP_USER / SMTP_PASSWORD
# Gmail / Outlook / iCloud / Yahoo.co.jp は SMTP_HOST 未指定でも自動補完
SMTP_USER=
SMTP_PASSWORD=
# 必要に応じて手動指定
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# 管理画面（アンバサダー一覧・累計紹介数・累計売上）。?key= でアクセス
ADMIN_SECRET=your_admin_secret_here
